# Copy to .env and fill in from `supabase status` (local) or the dashboard (hosted).
# .env is gitignored. Never commit real keys.

# Safe to ship in a client bundle: anon access is constrained by RLS.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS entirely — never put this in a mobile or web bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- apps/admin (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- apps/mobile (Expo) ---
# EXPO_PUBLIC_ vars are inlined into the bundle, so only ever the anon key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
