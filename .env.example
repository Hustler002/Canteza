# Environment, in three files — not one.
#
# Next and Expo both load env files from their own package directory and neither
# walks up to the monorepo root, so a single root .env configures the scripts and
# leaves both apps blank. Copy each block to the path above it.
#
# Fill from `supabase status` (local) or the dashboard (hosted): Settings -> API.
# All three are gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# .env          — `npm run verify:live` (node --env-file=.env), and exported
#                 into the shell for `npm run db:seed:users`
# ---------------------------------------------------------------------------

# Safe to ship in a client bundle: anon access is constrained by RLS.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS entirely — never put this in a mobile or web bundle,
# and never read it from verify-live.mjs, which must run as anon to test RLS at all.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. verify-live.mjs defaults to campus1234, the password seed-users.mjs sets.
# SEED_PASSWORD=campus1234

# Optional. seed-users.mjs refuses a hosted project unless this is set.
# ALLOW_REMOTE_SEED=1

# ---------------------------------------------------------------------------
# apps/admin/.env.local     — `next dev`, `next build`
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# apps/mobile/.env          — `expo start` (npm run dev:mobile)
# ---------------------------------------------------------------------------

# EXPO_PUBLIC_ vars are inlined into the bundle, so only ever the anon key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
