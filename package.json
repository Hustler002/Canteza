{
  "name": "canteza",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed:users": "node supabase/seed-users.mjs",
    "db:push": "supabase db push",
    "db:types": "node scripts/gen-types.mjs",
    "db:lint": "supabase db lint --level warning",
    "dev:mobile": "npm run start --workspace @canteza/mobile",
    "dev:admin": "npm run dev --workspace @canteza/admin"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
